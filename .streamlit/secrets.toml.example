# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml แล้วใส่ค่าจากผู้ให้บริการฐานข้อมูลบนคลาวด์
# (ไฟล์ secrets.toml ห้ามอัปขึ้น GitHub -- .gitignore กันไว้ให้แล้ว)
# บน Streamlit Community Cloud ให้วางเนื้อหาแบบเดียวกันนี้ที่ Settings > Secrets
[mysql]
host = "xxxx.clusters.tidbcloud.com"
port = 4000
user = "xxxx.root"
password = "รหัสผ่านที่ได้จากผู้ให้บริการ"
database = "casting_agency"
ssl = true
skip_create = true
